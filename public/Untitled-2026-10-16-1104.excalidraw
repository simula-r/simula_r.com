      "link": null,
      "locked": false,
      "text": "Now you know how I define the role. You know I am posed for the job. Now let's talk about you.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now you know how I define the role. You know I am posed for the job. Now let's talk about you.",
