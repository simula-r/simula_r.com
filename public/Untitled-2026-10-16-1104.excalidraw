    },
    {
      "id": "lwjfUe9hsbehWmbYn9zH8",
      "type": "text",
      "x": 12633.362977036675,
      "y": 1328.6739662602977,
      "width": 649.70166015625,
      "height": 34.80450641944276,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
