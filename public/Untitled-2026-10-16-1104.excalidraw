    },
    {
      "id": "OPTO5NiEl-agR6kYWRSiO",
      "type": "text",
      "x": 8493.077800106692,
      "y": 1410.1600447014287,
      "width": 491.9396667480469,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ag",
      "roundness": null,
      "seed": 488385435,
      "version": 1048,
      "versionNonce": 1703961115,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792176819889,
      "created": 1792176002797,
      "link": null,
      "locked": false,
      "text": "Not all products should make their product quality\npart of their moat.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Not all products should make their product quality\npart of their moat.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "zv5_PHRU1QQwu1P6-MdDk",
      "type": "text",
      "x": 9225.245539103964,
      "y": 1483.5732448045512,
      "width": 368.3597412109375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "agG",
      "roundness": null,
      "seed": 1557766651,
      "version": 1325,
      "versionNonce": 2131977915,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792176819889,
      "created": 1792176146005,
      "link": null,
      "locked": false,
      "text": "Being ambitious for the sake of being\nambitious is just treading water...",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Being ambitious for the sake of being\nambitious is just treading water...",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "KqcdYdGXsCkPuOSx2uUNf",
      "type": "text",
      "x": 9803.57356594942,
      "y": 1385.7492278835607,
      "width": 549.7196655273438,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "agK",
      "roundness": null,
      "seed": 1418043509,
      "version": 1558,
      "versionNonce": 1192023899,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792176819889,
      "created": 1792176236080,
      "link": null,
      "locked": false,
      "text": "I love LLMs and I use them to generate a lot of things.\nIncluding code, images, plain text etc.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "I love LLMs and I use them to generate a lot of things.\nIncluding code, images, plain text etc.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "FlpWojqnuaY41V3zdZTUw",
      "type": "text",
      "x": 9936.435330673528,
      "y": 1462.3780801137866,
      "width": 272.039794921875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "agM",
      "roundness": null,
      "seed": 289452341,
      "version": 1614,
      "versionNonce": 2077176827,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792176819889,
      "created": 1792176274309,
      "link": null,
      "locked": false,
      "text": "But... I am also an engineer.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "But... I am also an engineer.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "YmPcRLvSV-IkCd1kA12e2",
      "type": "text",
      "x": 9944.986755016334,
      "y": 1498.246904561977,
      "width": 239.7198028564453,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "agN",
      "roundness": null,
      "seed": 1056589819,
      "version": 1676,
      "versionNonce": 1834810523,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792176819889,
      "created": 1792176282651,
      "link": null,
      "locked": false,
      "text": "and... an actual deisgner.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "and... an actual deisgner.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "2auk3RZj5zeDo6xwzp-n_",
      "type": "text",
      "x": 9773.322308269806,
      "y": 1552.0501412342633,
      "width": 600.4395751953125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "agNV",
      "roundness": null,
      "seed": 865996251,
      "version": 1830,
      "versionNonce": 1198043451,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792176819889,
      "created": 1792176290614,
      "link": null,
      "locked": false,
      "text": "Let's focus more on what it is we are shipping and less about\nhow we built it please.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Let's focus more on what it is we are shipping and less about\nhow we built it please.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "wI4igcLrYLlZOLiG-1AIf",
      "type": "text",
      "x": 9221.028384655472,
      "y": 1556.0195451202849,
      "width": 423.15972900390625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "agO",
      "roundness": null,
      "seed": 850730421,
      "version": 1457,
      "versionNonce": 458543579,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792176819889,
      "created": 1792176173977,
      "link": null,
      "locked": false,
      "text": "I am huge believer of beating the averages.\n(Don't know what that entails? DM me.)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "I am huge believer of beating the averages.\n(Don't know what that entails? DM me.)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "1ew2oKhf5SZJ1jrcoAXOr",
      "type": "text",
      "x": 8440.025398431253,
      "y": 1476.7227467667742,
      "width": 611.7796630859375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "agV",
      "roundness": null,
      "seed": 1809646811,
      "version": 1185,
      "versionNonce": 708042363,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792176819889,
      "created": 1792176038208,
      "link": null,
      "locked": false,
      "text": "Product quality is less about the product itself and more of a\ntranslation of care for the users.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Product quality is less about the product itself and more of a\ntranslation of care for the users.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "BazyIEcB-GHurZOJIf8MO",
      "type": "text",
      "x": 8417.343439888273,
      "y": 1550.1530453256273,
      "width": 685.1796875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "agl",
      "roundness": null,
      "seed": 426982459,
      "version": 1414,
      "versionNonce": 1858623259,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792176819889,
      "created": 1792176094450,
      "link": null,
      "locked": false,
      "text": "If you are truly talking to customers, and truly want to offer delight,\ndesign and quality are table stakes.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If you are truly talking to customers, and truly want to offer delight,\ndesign and quality are table stakes.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "kByKUvZIC3VXcEohlfnft",
      "type": "text",
      "x": 8530.520599609808,
      "y": 2072.824774069858,
      "width": 472.399658203125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "agt",
      "roundness": null,
      "seed": 1982176725,
      "version": 1782,
      "versionNonce": 1736752059,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792176819889,
      "created": 1792176354738,
      "link": null,
      "locked": false,
      "text": "In this era, time to market is important.\nBut also making coherent decisions is important.\nThat comes with experience.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In this era, time to market is important.\nBut also making coherent decisions is important.\nThat comes with experience.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "vfzQSJrH8DB1MVdKQ4cv0",
      "type": "text",
      "x": 9613.295922202482,
      "y": 2037.9180445309958,
      "width": 436.7196960449219,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "agv",
      "roundness": null,
      "seed": 1253193595,
      "version": 2156,
      "versionNonce": 546016347,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792176819889,
      "created": 1792176458618,
      "link": null,
      "locked": false,
      "text": "Everyone needs a little something different.\nI thrive in transparency. The more is shared,\nthe more I can better decisions.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Everyone needs a little something different.\nI thrive in transparency. The more is shared,\nthe more I can better decisions.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "tvz0GzDeTUZpTVUn3V9Sz",
      "type": "text",
      "x": 8529.023219035822,
      "y": 2168.995157315022,
      "width": 505.8396911621094,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "agx",
      "roundness": null,
      "seed": 1099608795,
      "version": 1993,
      "versionNonce": 2108639483,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792176819889,
      "created": 1792176394341,
      "link": null,
      "locked": false,
      "text": "I deeply value orgs that know how to set a correct\ninformed pace. And I have no qualms about crunch...\nonly if it has no good reason.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "I deeply value orgs that know how to set a correct\ninformed pace. And I have no qualms about crunch...\nonly if it has no good reason.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "SCJd1npr-WRtRdP6528hX",
      "type": "text",
      "x": 6937.476654297865,
      "y": 2565.1058445708813,
      "width": 325.59979248046875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "agz",
      "roundness": null,
      "seed": 747113819,
      "version": 2138,
      "versionNonce": 335388149,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792176810835,
      "created": 1792176724142,
      "link": null,
      "locked": false,
      "text": "Here are my receipts so to speak.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here are my receipts so to speak.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "hQxr7BxvTAINX7meZngIy",
      "type": "text",
      "x": 6870.093768894762,
      "y": 2612.5132745839023,
      "width": 454.4397277832031,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "agzV",
      "roundness": null,
      "seed": 889174101,
      "version": 2230,
      "versionNonce": 1189091157,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792176810835,
      "created": 1792176735302,
      "link": null,
      "locked": false,
      "text": "And the projects I am most passionate about.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "And the projects I am most passionate about.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
